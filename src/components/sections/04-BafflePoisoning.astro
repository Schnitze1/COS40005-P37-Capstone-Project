---
import siteData from '../../content/site.json';
const { baffle } = siteData.acts;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

// Data points for BAFFLE contiguous poison evaluation on FrankaKitchen
const barData = [
  { rate: '0%', label: 'Clean', score: 1.67, color: '#4A9E9E', note: 'Reference' },
  { rate: '1%', label: '1%', score: 1.55, color: '#B4B5B1', note: 'Minor drop' },
  { rate: '5%', label: '5%', score: 1.53, color: '#B4B5B1', note: 'Stable' },
  { rate: '10%', label: '10%', score: 0.86, color: '#7D7E7B', note: 'Degraded' },
  { rate: '15%', label: '15%', score: 1.30, color: '#7D7E7B', note: 'Unstable' },
  { rate: '20%', label: '20%', score: 0.46, color: '#B33A3A', note: 'Hijacked' },
];

const chartWidth = 720;
const chartHeight = 280;
const marginLeft = 50;
const marginRight = 30;
const marginTop = 30;
const plotHeight = 190;
const baselineY = marginTop + plotHeight; // 220
const plotWidth = chartWidth - marginLeft - marginRight; // 640
const slotWidth = plotWidth / barData.length; // 106.67
const barWidth = 52;
---

<section id="baffle" class="act baffle-section">
  <div class="container">
    <div class="header-group">
      <span class="micro">{baffle.tag}</span>
      <h2 class="section-title">{baffle.heading}</h2>
      <p class="section-subtitle">{baffle.subHeading}</p>
    </div>

    <!-- Inline SVG Bar Chart -->
    <div class="chart-wrapper">
      <div class="chart-container">
        <svg
          class="baffle-chart-svg"
          viewBox={`0 0 ${chartWidth} ${chartHeight}`}
          preserveAspectRatio="xMidYMid meet"
          aria-label="Bar chart showing robot score drop as poison rate increases"
        >
          <!-- Grid lines & Y-axis labels (0 to 4.0) -->
          {([4.0, 3.0, 2.0, 1.0, 0.0]).map((yVal) => {
            const yPos = marginTop + ((4.0 - yVal) / 4.0) * plotHeight;
            return (
              <g class="grid-row">
                <line
                  x1={marginLeft}
                  y1={yPos}
                  x2={chartWidth - marginRight}
                  y2={yPos}
                  stroke={yVal === 0.0 ? '#1C1D1C' : 'rgba(255, 255, 255, 0.05)'}
                  stroke-dasharray={yVal === 0.0 ? 'none' : '3,3'}
                />
                <text
                  x={marginLeft - 12}
                  y={yPos + 4}
                  text-anchor="end"
                  class="svg-axis-label"
                >
                  {yVal.toFixed(1)}
                </text>
              </g>
            );
          })}

          <!-- Bars & labels -->
          {barData.map((d, i) => {
            const slotCenterX = marginLeft + i * slotWidth + slotWidth / 2;
            const barX = slotCenterX - barWidth / 2;
            const barHeight = (d.score / 4.0) * plotHeight;
            const barY = baselineY - barHeight;

            return (
              <g class="bar-group">
                <!-- Bar rect -->
                <rect
                  x={barX}
                  y={barY}
                  width={barWidth}
                  height={barHeight}
                  fill={d.color}
                  rx="2"
                  class="chart-bar"
                />

                <!-- Score value above bar -->
                <text
                  x={slotCenterX}
                  y={barY - 8}
                  text-anchor="middle"
                  class="svg-score-label"
                >
                  {d.score.toFixed(2)}
                </text>

                <!-- X-axis percentage label -->
                <text
                  x={slotCenterX}
                  y={baselineY + 20}
                  text-anchor="middle"
                  class="svg-x-label"
                >
                  {d.rate}
                </text>

                <!-- Outcome caption below rate -->
                <text
                  x={slotCenterX}
                  y={baselineY + 36}
                  text-anchor="middle"
                  class="svg-note-label"
                >
                  {d.note}
                </text>
              </g>
            );
          })}
        </svg>
      </div>

      <div class="chart-caption-row">
        <span class="micro">Evaluation Metric: Mean return on FrankaKitchen (0.00 – 4.00)</span>
        <span class="micro alert-note">20% poison triggers complete policy collapse</span>
      </div>
    </div>

    <div>
      <a href={`${basePath}${baffle.detailLink.href}`} class="tech-detail-link">
        {baffle.detailLink.text}
      </a>
    </div>
  </div>
</section>

<style>
  .baffle-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 0;
    box-sizing: border-box;
  }

  .header-group {
    margin-bottom: 2rem;
  }

  .section-title {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    color: var(--body);
    font-size: 1.15rem;
    max-width: 720px;
  }

  .chart-wrapper {
    max-width: 820px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 28px 24px 20px;
    margin: 1.5rem 0 2rem;
  }

  .chart-container {
    width: 100%;
  }

  .baffle-chart-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .svg-axis-label {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--muted);
  }

  .svg-score-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    fill: var(--ink);
  }

  .svg-x-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    fill: var(--ink);
  }

  .svg-note-label {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--muted);
  }

  .chart-bar {
    transition: opacity 200ms ease;
  }

  .chart-bar:hover {
    opacity: 0.85;
  }

  .chart-caption-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .alert-note {
    color: #B33A3A;
  }

  @media (max-width: 768px) {
    .chart-wrapper {
      padding: 16px 12px;
    }

    .chart-caption-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
