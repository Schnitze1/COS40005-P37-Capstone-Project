---
import siteData from '../../content/site.json';
const { unlearning } = siteData.acts;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="unlearning" class="act unlearning-section">
  <div class="container">
    <div class="header-group">
      <span class="micro">{unlearning.tag}</span>
      <h2 class="section-title">{unlearning.heading}</h2>
      <p class="section-subtitle">{unlearning.subHeading}</p>
    </div>

    <!-- Hero Moment: Interactive Split-Screen Comparison -->
    <div class="split-viewport-wrapper">
      <div id="comparison-viewer" class="comparison-viewer" style="--split-pos: 50%;">
        
        <!-- Right / Background Layer: Unlearned Policy -->
        <div class="layer layer-unlearned">
          <div class="layer-content">
            <div class="policy-header">
              <span class="micro badge-unlearned">UNLEARNED</span>
              <span class="policy-tagline">TrajDeleter Restored</span>
            </div>

            <div class="policy-metrics-block">
              <div class="policy-score-val text-accent">1.67</div>
              <div class="policy-score-label micro">Benchmark Return (Clean Restored)</div>
            </div>

            <div class="policy-status-rows">
              <div class="status-row">
                <span class="status-label micro">Backdoor Status</span>
                <span class="status-val micro text-accent">EXCISED / NEUTRALIZED</span>
              </div>
              <div class="status-row">
                <span class="status-label micro">Compute Cost</span>
                <span class="status-val micro text-accent">&lt; 3 mins (No Retraining)</span>
              </div>
              <div class="status-row">
                <span class="status-label micro">Clean Skill Retention</span>
                <span class="status-val micro text-accent">100% Intact</span>
              </div>
            </div>

            <div class="trajectory-viz clean-viz">
              <div class="viz-track">
                <div class="viz-node node-active"></div>
                <div class="viz-line line-clean"></div>
                <div class="viz-node node-active"></div>
                <div class="viz-line line-clean"></div>
                <div class="viz-node node-active"></div>
              </div>
              <span class="micro viz-desc">Clean sequence: Microwave → Kettle → Switch → Cabinet</span>
            </div>
          </div>
        </div>

        <!-- Left / Clipped Layer: Base Policy (Poisoned) -->
        <div class="layer layer-base">
          <div class="layer-content">
            <div class="policy-header">
              <span class="micro badge-base">BASE POLICY</span>
              <span class="policy-tagline">Poisoned / Damaged</span>
            </div>

            <div class="policy-metrics-block">
              <div class="policy-score-val text-corrupt">0.46</div>
              <div class="policy-score-label micro">Benchmark Return (20% Poisoned)</div>
            </div>

            <div class="policy-status-rows">
              <div class="status-row">
                <span class="status-label micro">Backdoor Status</span>
                <span class="status-val micro text-corrupt">TRIGGER ACTIVE</span>
              </div>
              <div class="status-row">
                <span class="status-label micro">Policy Deviation</span>
                <span class="status-val micro text-corrupt">Severe Trajectory Drift</span>
              </div>
              <div class="status-row">
                <span class="status-label micro">Task Success</span>
                <span class="status-val micro text-corrupt">Collapsed (11.5%)</span>
              </div>
            </div>

            <div class="trajectory-viz corrupt-viz">
              <div class="viz-track">
                <div class="viz-node node-corrupt"></div>
                <div class="viz-line line-corrupt"></div>
                <div class="viz-node node-corrupt"></div>
                <div class="viz-line line-corrupt"></div>
                <div class="viz-node node-fail"></div>
              </div>
              <span class="micro viz-desc">Corrupted sequence: Hijacked subtask execution failure</span>
            </div>
          </div>
        </div>

        <!-- Draggable Divider Line & 32px Handle -->
        <div id="comparison-divider" class="comparison-divider">
          <div id="comparison-handle" class="comparison-handle" aria-label="Drag to compare base and unlearned policies">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M5 4L1 8L5 12" stroke="#0A0B0D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M11 4L15 8L11 12" stroke="#0A0B0D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

      </div>

      <div class="split-caption-bar">
        <span class="micro">Drag divider to compare Base Policy against Unlearned state</span>
        <span class="micro divider-indicator">⇄ Interactive Policy Diff</span>
      </div>
    </div>

    <div>
      <a href={`${basePath}${unlearning.detailLink.href}`} class="tech-detail-link">
        {unlearning.detailLink.text}
      </a>
    </div>
  </div>
</section>

<style>
  .unlearning-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 0;
    box-sizing: border-box;
  }

  .header-group {
    margin-bottom: 2rem;
  }

  .section-title {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    color: var(--body);
    font-size: 1.15rem;
    max-width: 720px;
  }

  .split-viewport-wrapper {
    max-width: 1100px;
    width: 100%;
    margin: 1.5rem 0 2rem;
  }

  .comparison-viewer {
    position: relative;
    width: 100%;
    height: 480px;
    background: #0D0E12;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    user-select: none;
    touch-action: pan-y;
  }

  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .layer-unlearned {
    background: radial-gradient(circle at 80% 50%, rgba(74, 158, 158, 0.08) 0%, transparent 60%), #0D0E12;
    justify-content: flex-end;
  }

  .layer-base {
    background: radial-gradient(circle at 20% 50%, rgba(179, 58, 58, 0.09) 0%, transparent 60%), #08090C;
    width: var(--split-pos, 50%);
    overflow: hidden;
    z-index: 5;
    justify-content: flex-start;
    border-right: 2px solid transparent;
  }

  .layer-content {
    width: 100%;
    max-width: 520px;
    padding: 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .layer-base .layer-content {
    width: 520px; /* fixed inner width to avoid text wrapping as container resizes */
    flex-shrink: 0;
  }

  .policy-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .badge-base {
    background: rgba(179, 58, 58, 0.2);
    color: #E05A5A;
    padding: 4px 10px;
    border-radius: 2px;
    border: 1px solid rgba(179, 58, 58, 0.4);
    font-size: 11px;
    letter-spacing: 0.15em;
  }

  .badge-unlearned {
    background: rgba(74, 158, 158, 0.2);
    color: #4A9E9E;
    padding: 4px 10px;
    border-radius: 2px;
    border: 1px solid rgba(74, 158, 158, 0.4);
    font-size: 11px;
    letter-spacing: 0.15em;
  }

  .policy-tagline {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--ink);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .policy-score-val {
    font-family: var(--font-mono);
    font-size: 54px;
    font-weight: 600;
    line-height: 1.0;
    margin-bottom: 6px;
  }

  .text-accent {
    color: #4A9E9E;
  }

  .text-corrupt {
    color: #E05A5A;
  }

  .policy-score-label {
    color: var(--muted);
    font-size: 11px;
  }

  .policy-status-rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }

  .status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .status-label {
    color: var(--muted);
  }

  .trajectory-viz {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--line);
    padding: 14px 18px;
    border-radius: 4px;
  }

  .viz-track {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .viz-node {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .node-active {
    background: #4A9E9E;
    box-shadow: 0 0 8px #4A9E9E;
  }

  .node-corrupt {
    background: #E05A5A;
    box-shadow: 0 0 8px #E05A5A;
  }

  .node-fail {
    background: #4A1D1D;
    border: 1px solid #E05A5A;
  }

  .viz-line {
    flex: 1;
    height: 2px;
  }

  .line-clean {
    background: #4A9E9E;
  }

  .line-corrupt {
    background: #E05A5A;
    stroke-dasharray: 2, 2;
  }

  .viz-desc {
    font-size: 10px;
    color: var(--muted);
  }

  /* Draggable vertical divider line and handle */
  .comparison-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split-pos, 50%);
    width: 2px;
    background: #EFF0EB;
    z-index: 20;
    cursor: ew-resize;
    transform: translateX(-50%);
  }

  .comparison-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #EFF0EB;
    box-shadow: 0 0 16px rgba(0, 0, 0, 0.8), 0 0 4px rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: ew-resize;
    z-index: 21;
    transition: transform 150ms ease;
  }

  .comparison-handle:hover,
  .comparison-handle:active {
    transform: translate(-50%, -50%) scale(1.12);
  }

  .split-caption-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    padding: 0 4px;
  }

  .divider-indicator {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .comparison-viewer {
      height: 420px;
    }

    .layer-content {
      padding: 24px 20px;
      gap: 16px;
    }

    .layer-base .layer-content {
      width: 340px;
    }

    .policy-score-val {
      font-size: 40px;
    }
  }
</style>

<script>
  const viewer = document.getElementById('comparison-viewer');
  const divider = document.getElementById('comparison-divider');

  let isDragging = false;

  function updatePosition(clientX: number) {
    if (!viewer) return;
    const rect = viewer.getBoundingClientRect();
    let percent = ((clientX - rect.left) / rect.width) * 100;
    percent = Math.max(8, Math.min(92, percent));
    viewer.style.setProperty('--split-pos', `${percent.toFixed(2)}%`);
  }

  divider?.addEventListener('mousedown', (e) => {
    isDragging = true;
    e.preventDefault();
  });

  viewer?.addEventListener('mousedown', (e) => {
    isDragging = true;
    updatePosition(e.clientX);
  });

  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    updatePosition(e.clientX);
  });

  window.addEventListener('mouseup', () => {
    isDragging = false;
  });

  // Touch handlers
  divider?.addEventListener('touchstart', (e) => {
    isDragging = true;
    if (e.touches[0]) updatePosition(e.touches[0].clientX);
  }, { passive: true });

  viewer?.addEventListener('touchstart', (e) => {
    isDragging = true;
    if (e.touches[0]) updatePosition(e.touches[0].clientX);
  }, { passive: true });

  window.addEventListener('touchmove', (e) => {
    if (!isDragging || !e.touches[0]) return;
    updatePosition(e.touches[0].clientX);
  }, { passive: true });

  window.addEventListener('touchend', () => {
    isDragging = false;
  });
</script>
