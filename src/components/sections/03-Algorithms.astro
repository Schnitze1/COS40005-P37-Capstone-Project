---
import siteData from '../../content/site.json';
const { algorithms } = siteData.acts;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const cards = [
  {
    name: 'IQL',
    headline: '3.50',
    description: 'The strongest result on this benchmark.',
  },
  {
    name: 'CQL',
    headline: '1.02',
    description: 'Reliable at first, then declined.',
  },
  {
    name: 'BEAR',
    headline: '1.67',
    description: 'Our central focus and the most difficult to stabilise.',
  },
  {
    name: 'TD3+BC',
    headline: '0.38',
    description: 'Collapsed after the first epoch and never recovered.',
  },
];
---

<section id="algorithms" class="act algorithms-section">
  <div class="container">
    <span class="micro">{algorithms.tag}</span>
    <h2 class="section-title">{algorithms.heading}</h2>

    <div class="cards-strip-container">
      <div class="cards-strip">
        {cards.map((card) => (
          <div class="algorithm-card">
            <h3 class="card-name">{card.name}</h3>
            <div class="card-number">{card.headline}</div>
            <p class="card-desc">{card.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div>
      <a href={`${basePath}${algorithms.detailLink.href}`} class="tech-detail-link">
        {algorithms.detailLink.text}
      </a>
    </div>
  </div>
</section>

<style>
  .algorithms-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 0;
    box-sizing: border-box;
  }

  .section-title {
    margin-top: 0.5rem;
    margin-bottom: 2rem;
  }

  .cards-strip-container {
    width: 100%;
    margin: 1.5rem 0 2.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    padding-bottom: 12px;
  }

  .cards-strip-container::-webkit-scrollbar {
    height: 4px;
  }

  .cards-strip-container::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 2px;
  }

  .cards-strip {
    display: flex;
    gap: 24px;
    width: max-content;
  }

  .algorithm-card {
    width: 360px;
    min-width: 360px;
    scroll-snap-align: start;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--line);
    padding: 36px 32px;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    box-sizing: border-box;
    transition: border-color 200ms ease;
  }

  .algorithm-card:hover {
    border-color: var(--muted);
  }

  .card-name {
    font-family: var(--font-display);
    font-size: 32px;
    color: var(--ink);
    letter-spacing: 0.02em;
    line-height: 1.0;
    margin: 0;
  }

  .card-number {
    font-family: var(--font-mono);
    font-size: 48px;
    color: #EFF0EB;
    line-height: 1.0;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: 16px;
    color: #B4B5B1;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 768px) {
    .algorithm-card {
      width: 290px;
      min-width: 290px;
      padding: 28px 24px;
    }

    .card-number {
      font-size: 40px;
    }
  }
</style>
