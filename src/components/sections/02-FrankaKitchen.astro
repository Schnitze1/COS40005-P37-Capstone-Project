---
import site from '../../../content/site.json';
const act = site.acts.frankaKitchen;
---
<section id="franka-kitchen" class="act-fk">
  <div class="fk-bg">
    <img class="fk-poster" src="/franka-poster.webp" alt="" />
  </div>

  <div class="fk-top">
    <h2 class="fk-heading">{act.heading}</h2>
    <p class="fk-subheading">{act.subheading}</p>
  </div>

  <button class="fk-play" aria-label="Play video">
    <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
      <path d="M12 6L30 18L12 30V6Z" fill="currentColor"/>
    </svg>
  </button>
</section>

<style is:global>
  #franka-kitchen.act-fk {
    position: relative;
    height: 100vh;
    width: 100%;
    background: #000000;
    overflow: hidden;
    opacity: 0;
    margin-top: -100vh;
  }

  #franka-kitchen .fk-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #franka-kitchen .fk-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #franka-kitchen .fk-top {
    position: absolute;
    top: 9vh;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 60px;
  }

  #franka-kitchen .fk-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(72px, 8vw, 132px);
    line-height: 0.94;
    letter-spacing: 0.005em;
    color: #FFFFFF;
    text-transform: uppercase;
    margin: 0 0 16px 0;
    font-weight: 400;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.6);
  }

  #franka-kitchen .fk-subheading {
    font-family: 'Inter', sans-serif;
    font-size: clamp(11px, 0.8vw, 14px);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.4;
    margin: 0;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 600;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.8);
  }

  #franka-kitchen .fk-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: #FFFFFF;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #0A0B0D;
    padding-left: 6px;
    transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  #franka-kitchen .fk-play:hover {
    transform: translate(-50%, -50%) scale(1.05);
  }

  @media (max-width: 768px) {
    #franka-kitchen .fk-top { top: 6vh; padding: 0 24px; }
    #franka-kitchen .fk-heading { font-size: clamp(48px, 12vw, 72px); }
    #franka-kitchen .fk-play { width: 88px; height: 88px; }
  }
</style>
