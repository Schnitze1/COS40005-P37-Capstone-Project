---
import site from '../../../content/site.json';
const hero = site.acts.hero;
---
<section id="hero" class="hero">
  <div class="hero-sticky">
    <canvas class="hero-canvas" width="1920" height="1080"></canvas>
    <img class="hero-fallback" src="/hero-frames/frame-0001.webp" alt="" />

    <div class="hero-overlay"></div>

    <div class="hero-content">
      <h1 class="hero-title">{hero.title}</h1>
      <p class="hero-subtitle">{hero.subtitle}</p>
    </div>

    <div class="hero-meta">CAPEX 2026</div>
  </div>
</section>

<style is:global>
  html, body {
    overflow-x: clip !important;
  }

  #hero.hero {
    position: relative;
    height: 300vh;
    width: 100%;
    background: #000000;
  }

  #hero .hero-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
  }

  #hero .hero-canvas,
  #hero .hero-fallback {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    object-fit: cover;
    z-index: 0;
    pointer-events: none;
  }

  #hero .hero-canvas { display: block; }
  #hero .hero-fallback { display: none; }

  /* Fallback mode — if canvas fails, show the static first frame */
  #hero.hero-fallback-mode .hero-canvas { display: none; }
  #hero.hero-fallback-mode .hero-fallback { display: block; }

  #hero .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.25) 30%,
      rgba(0, 0, 0, 0.35) 60%,
      rgba(0, 0, 0, 0.85) 100%
    );
    pointer-events: none;
  }

  #hero .hero-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 60px;
  }

  #hero .hero-title {
    font-family: 'Bebas Neue', 'Anton', sans-serif;
    font-size: clamp(96px, 18vw, 280px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0 0 24px 0;
    text-transform: uppercase;
    font-weight: 400;
    display: block;
  }

  #hero .hero-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: clamp(18px, 1.5vw, 24px);
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.5;
    margin: 0;
    font-weight: 400;
    max-width: 900px;
  }

  #hero .hero-meta {
    position: absolute;
    top: 40px;
    left: 60px;
    z-index: 3;
    color: #FFFFFF;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    #hero .hero-content { padding: 0 24px; }
    #hero .hero-meta { top: 24px; left: 24px; }
  }
</style>

<script>
  const hero = document.querySelector('#hero');
  const canvas = document.querySelector('#hero .hero-canvas') as HTMLCanvasElement | null;
  const ctx = canvas ? canvas.getContext('2d') : null;

  if (hero && canvas && ctx) {
    const FRAME_COUNT = 72; // 72 WebP frames (3s * 24fps)
    const frames: HTMLImageElement[] = [];
    let framesLoaded = false;

    // Preload all frames
    const loadPromises: Promise<void>[] = [];
    for (let i = 1; i <= FRAME_COUNT; i++) {
      const img = new Image();
      const num = String(i).padStart(4, '0');
      img.src = `/hero-frames/frame-${num}.webp`;
      frames.push(img);
      loadPromises.push(new Promise((res) => {
        img.onload = () => {
          if (i === 1 && !framesLoaded) {
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          }
          res();
        };
        img.onerror = () => res();
      }));
    }

    Promise.all(loadPromises).then(() => {
      framesLoaded = true;
      // Draw first frame immediately
      if (frames[0] && frames[0].complete) {
        ctx.drawImage(frames[0], 0, 0, canvas.width, canvas.height);
      }
    });

    // Expose a global function that motion.js will call on scroll
    (window as any).__drawHeroFrame = (progress: number) => {
      if (!framesLoaded) return;
      const idx = Math.min(FRAME_COUNT - 1, Math.max(0, Math.floor(progress * (FRAME_COUNT - 1))));
      const img = frames[idx];
      if (img && img.complete) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      }
    };
  } else {
    if (hero) hero.classList.add('hero-fallback-mode');
  }
</script>
