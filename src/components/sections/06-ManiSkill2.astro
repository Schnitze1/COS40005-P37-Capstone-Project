---
import siteData from '../../content/site.json';
const { maniskill2 } = siteData.acts;
const { maniSkill2Clips } = siteData.mediaPlaceholders;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="maniskill" class="act maniskill-section">
  <div class="container">
    <span class="micro">{maniskill2.tag}</span>
    <h2 class="section-title">{maniskill2.heading}</h2>

    <div class="maniskill-content-grid">
      <div class="text-col">
        <div class="maniskill-body">
          {maniskill2.body.map((paragraph) => (
            <p class="body-p">{paragraph}</p>
          ))}
        </div>

        <div class="key-facts-block">
          <h3 class="key-facts-title">Key facts</h3>
          <ul class="key-facts-list">
            {maniskill2.keyFacts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="media-col">
        {maniSkill2Clips.map((clip) => (
          <div class="media-card">
            <div class="card-placeholder clip-placeholder">
              <span class="micro">{clip.badge}</span>
              <h4>{clip.title}</h4>
              <p class="placeholder-desc">{clip.description}</p>
              <div class="placeholder-path"><code>{clip.targetPath}</code></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div>
      <a href={`${basePath}${maniskill2.detailLink.href}`} class="tech-detail-link">
        {maniskill2.detailLink.text}
      </a>
    </div>
  </div>
</section>

<style>
  .maniskill-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 0;
    box-sizing: border-box;
  }

  .maniskill-content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 2rem;
  }

  .maniskill-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .body-p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-high);
  }

  .key-facts-block {
    margin-top: 1.5rem;
  }

  .key-facts-title {
    font-size: 1rem;
    color: var(--text-high);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .key-facts-list {
    list-style-type: disc;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .key-facts-list li {
    font-size: 1rem;
    color: var(--text-mid);
    line-height: 1.5;
  }

  .media-col {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .clip-placeholder {
    aspect-ratio: 16 / 9;
    min-height: 240px;
  }

  .placeholder-desc {
    font-size: 0.85rem;
    color: var(--text-mid);
    margin-top: 0.5rem;
  }

  .placeholder-path {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--text-low);
  }

  @media (max-width: 840px) {
    .maniskill-content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
