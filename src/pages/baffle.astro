---
import Layout from '../layouts/Layout.astro';
---

<Layout title="BAFFLE // TrajDeleter">
  <div class="subpage-placeholder-container container">
    <h1 class="subpage-title">BAFFLE</h1>
    <p class="muted-body">Technical detail is being finalised. Check back soon.</p>
  </div>
</Layout>

<style>
  .subpage-placeholder-container {
    padding: 6rem 1.5rem;
  }
  .subpage-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .muted-body {
    font-size: 1.1rem;
    color: var(--text-mid);
  }
</style>
