---
import Layout from '../layouts/Layout.astro';
import siteData from '../content/site.json';
const { problem } = siteData.acts;
const { algorithms } = siteData.acts;
---

<Layout title="Algorithms // TrajDeleter">
  <div class="subpage-container container">
    <span class="micro">Technical Architecture & Literature</span>
    <h1 class="subpage-title">Algorithms & Research Foundations</h1>
    <p class="lead-text">
      Offline reinforcement learning and machine unlearning benchmarks spanning five years of peer-reviewed methodology.
    </p>

    <section class="subpage-section">
      <h2 class="section-heading">Research Foundations & Literature</h2>
      <p class="section-intro">{problem.researchFoundations.intro}</p>
      
      <div class="citations-grid">
        {problem.researchFoundations.papers.map((paper) => (
          <div class="citation-card">
            <span class="micro citation-author">{paper.citation}</span>
            <h3 class="paper-title">{paper.title}</h3>
            <p class="paper-desc">{paper.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="subpage-section">
      <h2 class="section-heading">Offline RL Baseline Policies</h2>
      <div class="algo-details-grid">
        {algorithms.cards.map((card) => (
          <div class="algo-detail-card">
            <div class="card-top">
              <h3 class="algo-name">{card.name}</h3>
              <span class="algo-score">{card.score}</span>
            </div>
            <p class="algo-desc">{card.description}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .subpage-container {
    padding: 8rem 2.5rem 6rem;
    max-width: 1200px;
  }

  .subpage-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin: 0.5rem 0 1rem;
    line-height: 1.0;
  }

  .lead-text {
    font-size: 1.2rem;
    color: var(--body);
    max-width: 780px;
    margin-bottom: 4rem;
  }

  .subpage-section {
    margin-bottom: 5rem;
    border-top: 1px solid var(--line);
    padding-top: 3rem;
  }

  .section-heading {
    font-size: 2.2rem;
    margin-bottom: 1.5rem;
  }

  .section-intro {
    font-size: 1.1rem;
    color: var(--body);
    margin-bottom: 2rem;
    max-width: 760px;
  }

  .citations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .citation-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--line);
    padding: 2rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .citation-author {
    color: var(--accent);
  }

  .paper-title {
    font-size: 1.5rem;
    color: var(--ink);
  }

  .paper-desc {
    font-size: 0.95rem;
    color: var(--body);
    line-height: 1.6;
  }

  .algo-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .algo-detail-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--line);
    padding: 2rem;
    border-radius: 4px;
  }

  .card-top {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .algo-name {
    font-size: 1.8rem;
    color: var(--ink);
  }

  .algo-score {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
  }

  .algo-desc {
    font-size: 0.95rem;
    color: var(--body);
  }
</style>
