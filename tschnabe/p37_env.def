Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

%files
    requirements.txt /opt/requirements.txt

%post
       apt-get update && apt-get install -y python3 python3-pip xvfb git build-essential \
        libosmesa6-dev libgl1-mesa-glx libglfw3 libglew-dev wget unzip patchelf

    python3 -m pip install --upgrade pip

    mkdir -p /opt/mujoco
    wget https://mujoco.org/download/mujoco210-linux-x86_64.tar.gz -O /tmp/mujoco.tar.gz
    tar -xf /tmp/mujoco.tar.gz -C /opt/mujoco/
    rm /tmp/mujoco.tar.gz
    
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/opt/mujoco/mujoco210/bin
    export MUJOCO_PY_MUJOCO_PATH=/opt/mujoco/mujoco210
    pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118
    pip3 install setuptools==65.5.0 wheel==0.38.4 Cython==0.29.32
    
    # Note: Gym 0.23.1 is used for Python 3.10 compatibility
    pip3 install gym==0.23.1 --no-build-isolation
    pip3 install d3rlpy==1.0.0 --no-build-isolation
    pip3 install -r /opt/requirements.txt
    python3 -c "import mujoco_py"
    cp -r /usr/local/lib/python3.10/dist-packages/mujoco_py/generated /usr/local/lib/python3.10/dist-packages/mujoco_py/generated_bak    
    chmod -R 777 /usr/local/lib/python3.10/dist-packages/mujoco_py/	
%environment
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/opt/mujoco/mujoco210/bin
    export MUJOCO_PY_MUJOCO_PATH=/opt/mujoco/mujoco210
    export DISPLAY=:0
